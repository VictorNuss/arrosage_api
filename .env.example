# Copier ce fichier en ".env" et adapter les valeurs.

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=arrosage
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=arrosage
POSTGRES_PORT=5432

# --- Mosquitto (MQTT) ---
MQTT_PORT=1883
# Laisser vide pour un accès anonyme (réseau local de confiance uniquement).
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Dashboard Dash ---
DASHBOARD_PORT=8050

# Hauteur (cm) mesurée par le capteur de niveau d'eau quand la cuve est
# pleine. Utilisée pour la jauge "Cuve pleine" du dashboard.
TANK_HEIGHT_FULL_CM=150

# --- Service météo : coordonnées du jardin / point à prévoir ---
WEATHER_LAT=45.1885
WEATHER_LON=5.7245

# --- API Météo-France (portail-api.meteofrance.fr) ---
# Créer un compte gratuit, souscrire aux API "AROME", "ARPEGE" et "DPClim",
# puis générer une clé applicative (apikey). Voir README.md > Service météo.
METEOFRANCE_API_KEY=

# Station DPClim la plus proche pour la pluviométrie/température passées
# (voir README.md pour trouver l'identifiant de station via l'API DPClim).
METEOFRANCE_STATION_ID=

TZ=Europe/Paris
