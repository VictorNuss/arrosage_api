# Copier ce fichier en ".env" et adapter les valeurs.

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=arrosage
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=arrosage
POSTGRES_PORT=5432

# --- Mosquitto (MQTT) ---
MQTT_PORT=1883
# Laisser vide pour un accès anonyme (réseau local de confiance uniquement).
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Dashboard Dash ---
DASHBOARD_PORT=8050

# Hauteur (cm) mesurée par le capteur de niveau d'eau quand la cuve est
# pleine. Utilisée pour la jauge "Cuve pleine" du dashboard.
TANK_HEIGHT_FULL_CM=150

# --- Service météo (Open-Meteo, gratuit, sans clé) + carte radar Windy ---
# Coordonnées du jardin / point à prévoir. Utilisées par le service weather
# (prévisions AROME/ARPEGE via Open-Meteo) et par le dashboard (carte radar).
WEATHER_LAT=45.1885
WEATHER_LON=5.7245

# --- Capteurs Zigbee (optionnel, docker compose --profile zigbee) ---
# Chemin côté hôte de la clé USB Zigbee (ex : /dev/serial/by-id/usb-...).
ZIGBEE_ADAPTER=/dev/ttyACM0
# Port de l'interface web Zigbee2MQTT (appairage, renommage des capteurs).
ZIGBEE2MQTT_FRONTEND_PORT=8080
# mqtt.base_topic de Zigbee2MQTT. Vide = intégration désactivée dans ingest.
ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt

TZ=Europe/Paris
